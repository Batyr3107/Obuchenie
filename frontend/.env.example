# ============================================
# CourseRate Frontend Environment Variables
# ============================================

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
# Production example:
# VITE_API_URL=https://api.yourdomain.com/api/v1

# Application
VITE_APP_NAME=CourseRate
VITE_APP_VERSION=1.0.0

# Features Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false

# Analytics (если используется)
VITE_GA_TRACKING_ID=
VITE_GTM_ID=

# Sentry (если используется)
VITE_SENTRY_DSN=

# Pagination
VITE_DEFAULT_PAGE_SIZE=20

# File Upload
VITE_MAX_FILE_SIZE=5242880  # 5MB в байтах

# Environment
VITE_ENVIRONMENT=development  # development, staging, production
