# ============================================
# CourseRate Backend Environment Variables
# ============================================

# Environment
ENVIRONMENT=development  # development, staging, production

# Application
PROJECT_NAME=CourseRate
VERSION=1.0.0
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# API
API_V1_STR=/api/v1

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/courserate_db
# Для SQLite (только для development):
# DATABASE_URL=sqlite:///./courserate.db

# CORS (разделенные запятыми)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Production пример:
# BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Anti-spam settings
REVIEWS_PER_DAY_LIMIT=5
ACCOUNT_MIN_AGE_DAYS=3

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@courserate.com
SMTP_FROM_NAME=CourseRate
ENABLE_EMAIL=false  # true/false

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ADMIN_IDS=123456789,987654321  # Admin chat IDs (разделенные запятыми)
ENABLE_TELEGRAM=false  # true/false

# Rate Limiting (Redis)
RATE_LIMIT_STORAGE=memory://  # memory:// для dev, redis://localhost:6379 для prod
# Production пример:
# RATE_LIMIT_STORAGE=redis://redis:6379/0

# File Upload
MAX_UPLOAD_SIZE=5242880  # 5MB в байтах
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
ENABLE_CACHE=false  # true/false

# Monitoring & Error Tracking
SENTRY_DSN=  # Sentry DSN для error tracking (опционально)
ENABLE_SENTRY=false  # true/false

# Performance
WORKERS=4  # Количество Uvicorn workers для production
