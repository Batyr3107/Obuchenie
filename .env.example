# Database
DATABASE_URL=postgresql://courseuser:password@localhost:5432/courserate
POSTGRES_USER=courseuser
POSTGRES_PASSWORD=password
POSTGRES_DB=courserate

# JWT Settings
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Email
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@courserate.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=True
MAIL_SSL=False

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
PROJECT_NAME=CourseRate
VERSION=1.0.0
ENVIRONMENT=development

# Admin
FIRST_SUPERUSER_EMAIL=admin@courserate.com
FIRST_SUPERUSER_PASSWORD=changethis123
